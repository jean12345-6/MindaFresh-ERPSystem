{{!-- accounting/views/partials/nav.xian — Accounting top bar and flash messages (module-only, not in shared/) --}}
<header class="border-b border-line bg-white print:hidden">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-6 py-3">
    <a href="/" class="flex items-center gap-2 text-lg font-extrabold text-ink">
      <span class="inline-flex h-9 w-9 items-center justify-center rounded-xl bg-brand text-white">₱</span>
      MindaFresh <span class="font-semibold text-ink-muted">Accounting</span>
    </a>
    {{#if currentUser}}
    <div class="flex items-center gap-3 text-sm">
      <span class="text-ink-muted"><strong class="text-ink">{{currentUser.full_name}}</strong> · {{label currentUser.role}}</span>
      <a href="/logout" class="btn-outline min-h-[36px] px-3 text-sm">Log out</a>
    </div>
    {{/if}}
  </div>
  {{#if currentUser}}
  <nav class="mx-auto flex max-w-6xl flex-wrap gap-1 px-6 pb-2 text-sm font-semibold">
    {{#if (hasRole currentUser "accountant" "admin")}}
    <a href="/dashboard" class="rounded-lg px-3 py-2 {{#if (eq currentPath '/dashboard')}}bg-peach text-brand-dark{{else}}text-ink-soft hover:bg-peach-soft{{/if}}">Dashboard</a>
    <a href="/post" class="rounded-lg px-3 py-2 {{#if (eq currentPath '/post')}}bg-peach text-brand-dark{{else}}text-ink-soft hover:bg-peach-soft{{/if}}">Post transactions</a>
    <a href="/journal" class="rounded-lg px-3 py-2 {{#if (startsWith currentPath '/journal')}}bg-peach text-brand-dark{{else}}text-ink-soft hover:bg-peach-soft{{/if}}">Journal</a>
    <a href="/accounts" class="rounded-lg px-3 py-2 {{#if (eq currentPath '/accounts')}}bg-peach text-brand-dark{{else}}text-ink-soft hover:bg-peach-soft{{/if}}">Chart of accounts</a>
    {{/if}}
    <a href="/salary-releases" class="rounded-lg px-3 py-2 {{#if (eq currentPath '/salary-releases')}}bg-peach text-brand-dark{{else}}text-ink-soft hover:bg-peach-soft{{/if}}">Salary releases</a>
    {{#if (hasRole currentUser "accountant" "admin")}}
    <a href="/remittances" class="rounded-lg px-3 py-2 {{#if (eq currentPath '/remittances')}}bg-peach text-brand-dark{{else}}text-ink-soft hover:bg-peach-soft{{/if}}">Remittances</a>
    <a href="/reports" class="rounded-lg px-3 py-2 {{#if (startsWith currentPath '/reports')}}bg-peach text-brand-dark{{else}}text-ink-soft hover:bg-peach-soft{{/if}}">Reports</a>
    {{/if}}
  </nav>
  {{/if}}
</header>
<div class="mx-auto w-full max-w-6xl px-6 pt-5 print:hidden">
  {{#each success_msg}}<div class="mb-3 rounded-xl border border-[#CFE3B4] bg-leaf-bg px-4 py-3 text-sm font-semibold text-leaf">{{this}}</div>{{/each}}
  {{#each error_msg}}<div class="mb-3 rounded-xl border border-[#E3B3A8] bg-danger-bg px-4 py-3 text-sm font-semibold text-danger">{{this}}</div>{{/each}}
</div>
