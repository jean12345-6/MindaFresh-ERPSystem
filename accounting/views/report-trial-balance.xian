{{> head}}
{{> nav}}
<main class="mx-auto w-full max-w-4xl flex-1 px-6 py-6">
  <form class="flex flex-wrap items-end justify-between gap-3 print:hidden" method="GET">
    <a href="/reports" class="text-sm font-bold text-brand">← Reports</a>
    <div class="flex items-end gap-2"><div><label class="label">As of</label><input class="field mt-1" type="date" name="as_of" value="{{as_of}}"></div><button class="btn-dark">Show</button><button type="button" onclick="window.print()" class="btn-outline">Print</button></div>
  </form>
  <div class="card mt-4 p-6">
    <p class="text-sm font-bold text-ink-muted">MindaFresh Food Distribution, Inc.</p>
    <h1 class="text-2xl font-extrabold">Trial balance</h1>
    <p class="text-sm text-ink-muted">As of {{as_of}}</p>
    <table class="mt-4 w-full text-sm">
      <thead class="text-left text-ink-muted"><tr><th class="py-2">Code</th><th>Account</th><th class="text-right">Debit</th><th class="text-right">Credit</th></tr></thead>
      <tbody>{{#each tb.rows}}<tr class="border-t border-line"><td class="py-1.5 font-bold">{{account_code}}</td><td>{{account_name}}</td><td class="text-right">{{pesoOrBlank tb_debit}}</td><td class="text-right">{{pesoOrBlank tb_credit}}</td></tr>{{/each}}</tbody>
      <tfoot><tr class="border-t-2 border-ink font-extrabold"><td class="py-2" colspan="2">Total</td><td class="text-right">{{peso tb.total_debit}}</td><td class="text-right">{{peso tb.total_credit}}</td></tr></tfoot>
    </table>
    <p class="mt-4 badge {{#if tb.balanced}}bg-leaf-bg text-leaf{{else}}bg-danger-bg text-danger{{/if}}">{{#if tb.balanced}}Balanced: total debits equal total credits{{else}}Not balanced — check the journal{{/if}}</p>
  </div>
</main>
{{> footer}}
