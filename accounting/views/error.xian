{{> head}}
{{> nav}}
<main class="mx-auto w-full max-w-3xl flex-1 px-6 py-16">
  <div class="card p-8">
    <h1 class="text-2xl font-extrabold text-danger">{{heading}}</h1>
    <p class="mt-3 text-ink-soft">{{message}}</p>
    <div class="mt-6 flex gap-3"><a href="javascript:location.reload()" class="btn-primary">Reload</a><a href="/" class="btn-outline">Go to dashboard</a></div>
  </div>
</main>
{{> footer}}
