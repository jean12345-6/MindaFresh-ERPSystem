# --- pos/.env  (copy this file to .env) ---
PORT=3002
APP_NAME="MindaFresh POS"
TZ=Asia/Manila
SESSION_SECRET=change-me-to-a-long-random-text   # REQUIRED in production (the POS refuses to start with the default)

# --- going live (all optional) ---
# PUBLIC_URL=http://10.250.24.30:3002   # this laptop's address, so product photos you upload also load in the Online Shop
# NODE_ENV=production      # hides technical error text, requires a real SESSION_SECRET
# COOKIE_SECURE=1          # only when the site is opened over https
# TRUST_PROXY=1            # only when running behind nginx or a hosting proxy

# --- the same on all 5 laptops ---
DB_HOST=127.0.0.1             # 127.0.0.1 in solo mode; the DB host's IPv4 at joint tests
DB_PORT=3306
DB_NAME=mindafresh_db
DB_USER=mindafresh
DB_PASS=MindaFresh@2026
