{{> pos-head}}
{{> nav}}
<main class="mx-auto w-full max-w-4xl flex-1 px-4 py-6 sm:px-6">
  {{> flash}}
  <div class="mb-4">
    <h1 class="text-2xl font-extrabold">Settings</h1>
  </div>

  <form id="settingsForm" action="/settings" method="POST" enctype="multipart/form-data">
    <div class="mb-4 flex flex-wrap gap-2" id="tabs">
      <button type="button" data-tab="store" class="chip border-brand bg-brand text-white">Store &amp; receipt</button>
      <button type="button" data-tab="cashier" class="chip border-line-strong bg-white">Cashier</button>
      <button type="button" data-tab="keys" class="chip border-line-strong bg-white">Shortcuts</button>
      <button type="button" data-tab="inventory" class="chip border-line-strong bg-white">Inventory</button>
      <button type="button" data-tab="images" class="chip border-line-strong bg-white">Images</button>
      <button type="button" data-tab="security" class="chip border-line-strong bg-white">Security</button>
    </div>

    <!-- Store & receipt -->
    <section data-panel="store" class="card space-y-4 p-6">
      <h2 class="text-lg font-extrabold">Store details</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2"><label class="label" for="storeName">Store name</label><input id="storeName" name="storeName" value="{{s.storeName}}" maxlength="80" class="field mt-1" required></div>
        <div class="sm:col-span-2"><label class="label" for="storeAddress">Address</label><input id="storeAddress" name="storeAddress" value="{{s.storeAddress}}" maxlength="120" class="field mt-1"></div>
        <div><label class="label" for="storePhone">Phone</label><input id="storePhone" name="storePhone" value="{{s.storePhone}}" maxlength="30" class="field mt-1"></div>
        <div><label class="label" for="storeTin">TIN (optional)</label><input id="storeTin" name="storeTin" value="{{s.storeTin}}" maxlength="30" class="field mt-1"></div>
      </div>
      <h2 class="pt-2 text-lg font-extrabold">Receipt</h2>
      <div><label class="label" for="receiptFooter">Footer message</label><input id="receiptFooter" name="receiptFooter" value="{{s.receiptFooter}}" maxlength="120" class="field mt-1"></div>
      <label class="flex items-center gap-3 font-semibold"><input type="checkbox" name="receiptShowCashier" value="1" class="h-5 w-5 accent-brand" {{#if s.receiptShowCashier}}checked{{/if}}> Show the cashier name on the receipt</label>
      <label class="flex items-center gap-3 font-semibold"><input type="checkbox" name="autoPrint" value="1" class="h-5 w-5 accent-brand" {{#if s.autoPrint}}checked{{/if}}> Open the print window right after a sale</label>
    </section>

    <!-- Cashier -->
    <section data-panel="cashier" class="card hidden space-y-5 p-6">
      <div>
        <label class="flex items-start gap-3 font-semibold"><input type="checkbox" name="showStoreImage" value="1" class="mt-1 h-5 w-5 accent-brand" {{#if s.showStoreImage}}checked{{/if}}>
          <span>Show store image in the Cashier</span></label>
        <img id="storePreview" src="{{s.storeImageUrl}}" alt="" class="mt-3 h-44 w-full rounded-2xl border border-line object-cover" onerror="this.style.display='none'">
        <div class="mt-3 flex flex-wrap items-center gap-3">
          <label class="btn-outline cursor-pointer">{{{icon 'upload'}}}Upload image<input type="file" name="storeImage" data-image data-preview="#storePreview" data-name="#storeName2" class="sr-only"></label>
          <span id="storeName2" class="text-sm text-ink-muted"></span>
          <label class="ml-auto flex items-center gap-2 text-sm font-semibold"><input type="checkbox" name="reset_image" value="1" class="h-4 w-4 accent-brand"> Use the default photo</label>
        </div>
      </div>

      <div class="border-t border-line pt-5">
        <h2 class="text-lg font-extrabold">Payment methods</h2>
        <div class="mt-2 flex flex-wrap gap-5 font-semibold">
          <label class="flex items-center gap-2"><input type="checkbox" name="payCash" value="1" class="h-5 w-5 accent-brand" {{#if s.payCash}}checked{{/if}}> Cash</label>
          <label class="flex items-center gap-2"><input type="checkbox" name="payGcash" value="1" class="h-5 w-5 accent-brand" {{#if s.payGcash}}checked{{/if}}> GCash</label>
          <label class="flex items-center gap-2"><input type="checkbox" name="payCard" value="1" class="h-5 w-5 accent-brand" {{#if s.payCard}}checked{{/if}}> Card</label>
        </div>
        <div class="mt-3 max-w-xs"><label class="label" for="defaultPayment">Selected by default</label>
          <select id="defaultPayment" name="defaultPayment" class="field mt-1">{{#each pays}}<option value="{{p}}" {{#if selected}}selected{{/if}}>{{label p}}</option>{{/each}}</select></div>
      </div>

      <div class="border-t border-line pt-5">
        <h2 class="text-lg font-extrabold">Discounts</h2>
        <label class="mt-2 flex items-center gap-3 font-semibold"><input type="checkbox" name="allowDiscount" value="1" class="h-5 w-5 accent-brand" {{#if s.allowDiscount}}checked{{/if}}> Allow discounts at the cashier</label>
        <div class="mt-3 max-w-xs"><label class="label" for="maxDiscountPct">Largest discount (% of the sale)</label>
          <input id="maxDiscountPct" name="maxDiscountPct" type="number" min="0" max="100" step="1" value="{{s.maxDiscountPct}}" class="field mt-1"></div>
      </div>

      <div class="border-t border-line pt-5">
        <h2 class="text-lg font-extrabold">Cash entry</h2>
        <div class="mt-2 max-w-md"><label class="label" for="quickCash">Quick cash buttons (pesos, separated by commas)</label>
          <input id="quickCash" name="quickCash" value="{{s.quickCash}}" class="field mt-1" placeholder="100,200,500,1000"></div>
        <label class="mt-3 flex items-center gap-3 font-semibold"><input type="checkbox" name="scanSound" value="1" class="h-5 w-5 accent-brand" {{#if s.scanSound}}checked{{/if}}> Beep when an item is added or not found</label>
        <label class="mt-3 flex items-center gap-3 font-semibold"><input type="checkbox" name="printSound" value="1" class="h-5 w-5 accent-brand" {{#if s.printSound}}checked{{/if}}> Play the receipt-printing sound after a sale</label>
      </div>
    </section>

    <!-- Shortcuts -->
    <section data-panel="keys" class="card hidden p-6">
      <div class="flex flex-wrap items-center gap-3">
        <div class="mr-auto"><h2 class="text-lg font-extrabold">Cashier shortcuts</h2></div>
        <button type="button" id="resetKeys" class="btn-outline min-h-[40px] px-4 text-sm">Reset to default</button>
      </div>
      <div class="mt-4 divide-y divide-line">
        {{#each shortcuts}}
        <div class="flex items-center gap-4 py-3">
          <label class="flex-1 font-semibold" for="key_{{id}}">{{this.label}}</label>
          <select id="key_{{id}}" name="key_{{id}}" data-default="{{def}}" class="field max-w-[120px]">{{#each options}}<option value="{{key}}" {{#if selected}}selected{{/if}}>{{key}}</option>{{/each}}</select>
        </div>
        {{/each}}
      </div>
    </section>

    <!-- Inventory -->
    <section data-panel="inventory" class="card hidden space-y-4 p-6">
      <h2 class="text-lg font-extrabold">New product defaults</h2>
      <div class="grid gap-4 sm:grid-cols-2">
        <div><label class="label" for="defaultReorder">Reorder level</label><input id="defaultReorder" name="defaultReorder" type="number" min="0" step="1" value="{{s.defaultReorder}}" class="field mt-1"></div>
        <div><label class="label" for="defaultUnit">Unit</label>
          <select id="defaultUnit" name="defaultUnit" class="field mt-1">{{#each units}}<option value="{{u}}" {{#if selected}}selected{{/if}}>{{u}}</option>{{/each}}</select></div>
      </div>
    </section>

    <!-- Product images -->
    <section data-panel="images" class="card hidden space-y-4 p-6">
      <h2 class="text-lg font-extrabold">Product image links</h2>
      <div class="rounded-xl border border-line bg-peach-soft px-4 py-3">
        <p class="text-sm font-bold">This laptop's address for images</p>
        <p class="mt-1 font-mono text-[15px]">{{imageBase}}</p>
      </div>
      <button type="submit" formaction="/settings/refresh-image-links" formnovalidate class="btn-outline">Update all uploaded product image links</button>
    </section>

    <!-- Security -->
    <section data-panel="security" class="card hidden space-y-4 p-6">
      <h2 class="text-lg font-extrabold">Sessions</h2>
      <div class="max-w-xs"><label class="label" for="sessionHours">Stay logged in for (hours)</label>
        <input id="sessionHours" name="sessionHours" type="number" min="1" max="24" step="1" value="{{s.sessionHours}}" class="field mt-1">
</div>
      <div class="border-t border-line pt-4">
        <h2 class="text-lg font-extrabold">Reset</h2>
        <button type="submit" formaction="/settings/reset" formnovalidate id="resetAll" class="btn-danger mt-3">Reset all settings</button>
      </div>
    </section>

    <div class="sticky bottom-0 -mx-4 mt-4 flex items-center gap-3 border-t border-line bg-cream/95 px-4 py-3 backdrop-blur sm:-mx-6 sm:px-6">
      <button class="btn-primary">Save settings</button>
    </div>
  </form>
</main>

<script>
  const tabs = document.querySelectorAll("#tabs [data-tab]"), panels = document.querySelectorAll("[data-panel]");
  function showTab(name) {
    panels.forEach((p) => p.classList.toggle("hidden", p.dataset.panel !== name));
    tabs.forEach((t) => {
      const on = t.dataset.tab === name;
      t.classList.toggle("bg-brand", on); t.classList.toggle("text-white", on); t.classList.toggle("border-brand", on);
      t.classList.toggle("bg-white", !on); t.classList.toggle("border-line-strong", !on);
    });
    try { sessionStorage.setItem("posSettingsTab", name); } catch {}
  }
  tabs.forEach((t) => t.addEventListener("click", () => showTab(t.dataset.tab)));
  let start = "store"; try { start = sessionStorage.getItem("posSettingsTab") || "store"; } catch {}
  showTab(start);
  document.getElementById("resetKeys").addEventListener("click", () => {
    document.querySelectorAll("select[data-default]").forEach((s) => { s.value = s.dataset.default; });
  });
  document.getElementById("resetAll").addEventListener("click", async (e) => {
    e.preventDefault();
    const form = document.getElementById("settingsForm");
    const r = await Swal.fire({ icon: "warning", title: "Reset all settings?", text: "Every setting goes back to the default.", showCancelButton: true, confirmButtonText: "Reset", cancelButtonText: "Cancel", reverseButtons: true, confirmButtonColor: "#B42318" });
    if (r.isConfirmed) { form.action = "/settings/reset"; form.removeAttribute("enctype"); form.submit(); }
  });
</script>
{{> pos-footer}}
