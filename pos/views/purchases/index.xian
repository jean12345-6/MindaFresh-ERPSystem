{{> pos-head}}
{{> nav}}
<main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-6">
  {{> flash}}
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <h1 class="text-2xl font-extrabold">Purchase orders</h1>
    <div class="flex gap-2"><a href="/purchase-orders/new?low=1" class="btn-outline">Restock low items</a><a href="/purchase-orders/new" class="btn-primary">New purchase order</a></div>
  </div>
  <div class="mb-4 flex flex-wrap gap-2">
    <a href="/purchase-orders" class="chip {{#if (eq status '')}}border-brand bg-brand text-white{{else}}border-line-strong bg-white{{/if}}">All</a>
    {{#each statuses}}<a href="/purchase-orders?status={{this}}" class="chip {{#if (eq this ../status)}}border-brand bg-brand text-white{{else}}border-line-strong bg-white{{/if}}">{{this}}</a>{{/each}}
  </div>
  <div class="card overflow-x-auto">
    <table class="w-full text-left text-[15px]">
      <thead class="border-b border-line text-sm text-ink-muted"><tr>
        <th class="px-4 py-3">PO</th><th class="px-4 py-3">Supplier</th><th class="px-4 py-3">Order date</th><th class="px-4 py-3">Expected</th>
        <th class="px-4 py-3">Payment</th><th class="px-4 py-3 text-right">Total cost</th><th class="px-4 py-3">Status</th></tr></thead>
      <tbody class="divide-y divide-line">
        {{#each orders}}
        <tr class="hover:bg-peach-soft">
          <td class="px-4 py-3 font-bold"><a class="text-brand" href="/purchase-orders/{{id}}">{{purchase_order_code}}</a></td>
          <td class="px-4 py-3">{{Supplier.name}}</td>
          <td class="px-4 py-3">{{order_date}}</td>
          <td class="px-4 py-3">{{expected_date}}</td>
          <td class="px-4 py-3">{{label payment_method}}</td>
          <td class="px-4 py-3 text-right font-bold">{{peso total_cost}}</td>
          <td class="px-4 py-3"><span class="badge {{badge status}}">{{status}}</span></td>
        </tr>
        {{else}}<tr><td colspan="7" class="px-4 py-8 text-center text-ink-muted">No purchase orders.</td></tr>{{/each}}
      </tbody>
    </table>
  </div>
</main>
{{> pos-footer}}
