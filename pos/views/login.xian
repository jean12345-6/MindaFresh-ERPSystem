{{> pos-head}}
<main class="grid min-h-screen lg:grid-cols-[1.15fr_1fr]">
  <!-- Brand panel -->
  <section class="relative hidden overflow-hidden bg-ink lg:block">
    <img src="{{cfg.storeImageUrl}}" alt="" class="absolute inset-0 h-full w-full object-cover opacity-55" onerror="this.style.display='none'">
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/70 to-brand/50"></div>
    <div class="relative flex h-full flex-col justify-between p-12 text-white">
      <div class="flex items-center gap-3">
        <img src="/img/logo.png" alt="" class="h-12 w-12">
        <span class="text-2xl font-extrabold leading-none">MindaFresh <span class="text-brand-light">POS</span></span>
      </div>
      <div>
        <p class="text-sm font-bold uppercase tracking-[0.2em] text-brand-light">Point of Sale System</p>
        <h2 class="mt-3 text-4xl font-extrabold leading-tight">{{cfg.storeName}}</h2>
        {{#if cfg.storeAddress}}<p class="mt-3 text-lg text-[#C9AE98]">{{cfg.storeAddress}}</p>{{/if}}
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="flex items-center justify-center bg-cream px-6 py-12">
    <div class="w-full max-w-[420px]">
      <div class="mb-8 flex items-center gap-3 lg:hidden">
        <img src="/img/logo.png" alt="" class="h-12 w-12">
        <span class="text-2xl font-extrabold leading-none">MindaFresh <span class="text-brand">POS</span></span>
      </div>
      <h1 class="text-4xl font-extrabold tracking-tight">Log in</h1>
      {{> flash}}
      <form id="loginForm" action="/login" method="POST" class="mt-8 space-y-5">
        <div>
          <label for="username" class="label">Username</label>
          <div class="relative mt-1.5">
            <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-ink-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/></svg>
            <input id="username" name="username" class="field h-[52px] pl-12" autocomplete="username" required autofocus>
          </div>
        </div>
        <div>
          <label for="password" class="label">Password</label>
          <div class="relative mt-1.5">
            <svg class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-ink-muted" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="10" width="16" height="11" rx="2"/><path d="M8 10V7a4 4 0 018 0v3"/></svg>
            <input id="password" name="password" type="password" class="field h-[52px] pl-12 pr-12" autocomplete="current-password" required>
            <button type="button" id="togglePw" class="absolute right-3 top-1/2 -translate-y-1/2 rounded-lg p-1.5 text-ink-muted hover:bg-peach-soft" aria-label="Show password">
              <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
          </div>
        </div>
        <button id="loginBtn" class="btn-primary h-[52px] w-full text-base">Log in</button>
      </form>
      <p class="mt-10 text-center text-xs text-ink-muted">MindaFresh Food Distribution, Inc.{{#if cfg.storeAddress}} · {{cfg.storeAddress}}{{/if}}</p>
    </div>
  </section>
</main>

<script>
  const pw = document.getElementById("password");
  document.getElementById("togglePw").addEventListener("click", () => { pw.type = pw.type === "password" ? "text" : "password"; });
  document.getElementById("loginForm").addEventListener("submit", () => {
    const b = document.getElementById("loginBtn"); b.disabled = true; b.textContent = "Logging in…";
  });

  // Database offline: stay on the form and explain it in a modal.
  const DB_TARGET = {{{json dbTarget}}};
  function showOffline() {
    Swal.fire({
      icon: "error", title: "Database is offline",
      html: "The POS cannot reach the shared database at <b>" + DB_TARGET + "</b>.<br>Make sure the host laptop is awake and Laragon is running.",
      confirmButtonText: "Try again", showCancelButton: true, cancelButtonText: "Close", reverseButtons: true,
      confirmButtonColor: "#C2410C", showLoaderOnConfirm: true, allowOutsideClick: () => !Swal.isLoading(),
      preConfirm: async () => {
        try { const r = await fetch("/health/db", { cache: "no-store" }); if (!(await r.json()).ok) throw new Error("offline"); return true; }
        catch { Swal.showValidationMessage("Still offline. Check the connection and try again."); return false; }
      }
    }).then((r) => { if (r.isConfirmed) window.notify("success", "Database connected. You can log in now."); });
  }
  {{#if offline}}
  history.replaceState(null, "", "/login");
  window.addEventListener("load", () => setTimeout(showOffline, 150));
  {{/if}}
</script>
{{> pos-end}}
