{{> pos-head}}
{{> nav}}
<main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-6">
  {{> flash}}
  <div class="grid gap-6 lg:grid-cols-[1fr_380px]">
    <!-- Search + store image / product grid -->
    <section>
      <div class="flex flex-wrap items-center gap-3">
        <h1 class="mr-auto text-2xl font-extrabold">Cashier</h1>
        <button type="button" id="shortcutsBtn" class="btn-outline min-h-[40px] px-3 text-sm">{{{icon 'keyboard'}}}Shortcuts</button>
      </div>
      <div class="relative mt-3">
        <input id="search" class="field h-14 w-full text-lg" placeholder="Scan barcode or search product name" autocomplete="off" autofocus>
        <ul id="results" class="card absolute left-0 right-0 top-full z-20 mt-1 hidden max-h-[50vh] divide-y divide-line overflow-y-auto shadow-lg"></ul>
      </div>
      <p id="scanMsg" class="mt-2 hidden rounded-xl bg-leaf-bg px-3 py-2 text-sm font-semibold text-leaf"></p>

      {{#if settings.showStoreImage}}
      <div id="storeImg" class="mt-4 overflow-hidden rounded-3xl border border-line bg-peach-soft">
        <img src="{{settings.storeImageUrl}}" alt="MindaFresh store" class="h-[46vh] min-h-[240px] w-full object-cover" onerror="this.parentNode.classList.add('hidden')">
      </div>
      {{else}}
      <div id="cats" class="mt-3 flex flex-wrap gap-2">
        <button type="button" data-cat="" class="chip border-brand bg-brand text-white">All</button>
        {{#each categories}}<button type="button" data-cat="{{this}}" class="chip border-line-strong bg-white text-ink">{{this}}</button>{{/each}}
      </div>
      <div id="grid" class="mt-4 grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-4"></div>
      <p id="empty" class="mt-6 hidden text-center text-ink-muted">No product matches.</p>
      {{/if}}

    </section>

    <!-- Cart -->
    <aside class="card flex h-fit flex-col p-5 lg:sticky lg:top-4">
      <div class="flex items-center justify-between">
        <h2 class="text-lg font-extrabold">Current sale</h2>
        <button type="button" id="clear" class="text-sm font-bold text-danger">Clear</button>
      </div>
      <ul id="cart" class="mt-3 max-h-[38vh] divide-y divide-line overflow-y-auto"></ul>
      <p id="cartEmpty" class="py-8 text-center text-ink-muted">Scan or type a product to start.</p>

      <form id="checkoutForm" action="/cashier/checkout" method="POST" class="mt-4 space-y-3 border-t border-line pt-4">
        <input type="hidden" name="cart" id="cartField">
        <div class="flex justify-between text-[15px]"><span>Subtotal</span><strong id="subtotal">₱0.00</strong></div>
        <div class="flex items-center justify-between gap-3">
          <label for="discount" class="label">Discount (₱)</label>
          <input id="discount" name="discount" type="number" min="0" step="0.01" value="0" class="field max-w-[140px] text-right">
        </div>
        <div class="flex justify-between text-xl font-extrabold"><span>Total</span><span id="total">₱0.00</span></div>

        <div class="grid grid-cols-3 gap-2" id="methods">
          <label class="chip cursor-pointer justify-center border-line-strong has-[:checked]:border-brand has-[:checked]:bg-peach"><input type="radio" name="payment_method" value="cash" class="sr-only" checked>Cash</label>
          <label class="chip cursor-pointer justify-center border-line-strong has-[:checked]:border-brand has-[:checked]:bg-peach"><input type="radio" name="payment_method" value="gcash" class="sr-only">GCash</label>
          <label class="chip cursor-pointer justify-center border-line-strong has-[:checked]:border-brand has-[:checked]:bg-peach"><input type="radio" name="payment_method" value="card" class="sr-only">Card</label>
        </div>

        <div id="cashBox" class="space-y-2">
          <div class="flex items-center justify-between gap-3">
            <label for="amountPaid" class="label">Cash received (₱)</label>
            <input id="amountPaid" name="amount_paid" type="number" min="0" step="0.01" class="field max-w-[140px] text-right">
          </div>
          <div id="quick" class="flex flex-wrap justify-end gap-2"></div>
          <div class="flex justify-between text-[15px]"><span>Change</span><strong id="change">₱0.00</strong></div>
        </div>

        <p id="warn" class="hidden rounded-xl bg-danger-bg px-3 py-2 text-sm font-semibold text-danger"></p>
        <p id="payHint" class="text-center text-sm font-semibold text-ink-muted"></p>
        <button id="payBtn" class="btn-primary w-full text-lg">Complete sale</button>
      </form>
    </aside>
  </div>
</main>

<script>
  const PRODUCTS = {{{json products}}};
  const CFG = {{{json cfg}}};
  const QUICK = String(CFG.quickCash).split(",").map(Number).filter((n) => n > 0);
  const GRID_MODE = {{#if settings.showStoreImage}}false{{else}}true{{/if}};
  const fmt = (n) => "₱" + Number(n).toLocaleString("en-PH", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const r2 = (n) => Math.round((Number(n) + Number.EPSILON) * 100) / 100;
  const $ = (id) => document.getElementById(id);
  const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;" }[c]));
  const thumb = (p, px) => p.image
    ? `<img src="${esc(p.image)}" alt="" loading="lazy" class="shrink-0 rounded-lg border border-line object-cover" style="width:${px}px;height:${px}px">`
    : `<span class="shrink-0 rounded-lg border border-line bg-peach-soft" style="width:${px}px;height:${px}px"></span>`;
  const cart = new Map(); // product id -> quantity
  let cat = "", hi = 0, sel = null;

  // "10@112233" -> { qty: 10, term: "112233" }; plain text -> { qty: 1, term: text }
  function parse(raw) {
    const m = raw.trim().match(/^(\d+)\s*[@*]\s*(.*)$/);
    return m ? { qty: Math.max(parseInt(m[1], 10), 1), term: m[2].trim() } : { qty: 1, term: raw.trim() };
  }
  const numPart = (c) => String(parseInt(String(c || "").replace(/\D/g, ""), 10) || "");
  function exact(term) {
    const t = term.toLowerCase();
    if (!t) return null;
    return PRODUCTS.find((p) => p.barcode && p.barcode.toLowerCase() === t)
      || PRODUCTS.find((p) => (p.code || "").toLowerCase() === t)
      || (/^\d+$/.test(t) ? PRODUCTS.find((p) => !p.barcode && numPart(p.code) === numPart(t)) : null) || null;
  }
  // Best match first: exact code, name starts with the text, a word in the name starts with it, code starts with it, then anywhere. Ties: A to Z.
  function rank(p, t) {
    const name = p.name.toLowerCase(), code = (p.code || "").toLowerCase(), bar = (p.barcode || "").toLowerCase();
    if (bar === t || code === t) return 0;
    if (name.startsWith(t)) return 1;
    if (name.split(/[\s,()\-\/]+/).some((w) => w.startsWith(t))) return 2;
    if (bar.startsWith(t) || code.startsWith(t)) return 3;
    if (name.includes(t)) return 4;
    if (bar.includes(t) || code.includes(t)) return 5;
    return -1;
  }
  function matches(term) {
    const t = term.toLowerCase();
    if (!t) return [];
    return PRODUCTS.map((p) => ({ p, r: rank(p, t) })).filter((x) => x.r >= 0)
      .sort((x, y) => x.r - y.r || x.p.name.localeCompare(y.p.name)).map((x) => x.p);
  }

  function renderResults() {
    const { term } = parse($("search").value);
    const list = matches(term).slice(0, 8);
    if (hi >= list.length) hi = 0;
    $("results").classList.toggle("hidden", !term);
    $("results").innerHTML = list.length ? list.map((p, i) => {
      const left = p.stock - (cart.get(p.id) || 0);
      return `<li data-id="${p.id}" class="flex cursor-pointer items-center gap-3 px-4 py-3 ${i === hi ? "bg-peach" : "hover:bg-peach-soft"} ${left <= 0 ? "opacity-50" : ""}">
        ${thumb(p, 40)}
        <span class="w-20 shrink-0 text-xs font-bold text-ink-muted">${esc(p.barcode || p.code)}</span>
        <span class="flex-1 font-bold">${esc(p.name)}</span>
        <span class="text-xs ${left <= 5 ? "font-bold text-danger" : "text-ink-muted"}">${left <= 0 ? "Out of stock" : left + " " + esc(p.unit)}</span>
        <span class="w-24 text-right font-extrabold text-brand">${fmt(p.price)}</span></li>`;
    }).join("") : (term ? '<li class="px-4 py-3 text-ink-muted">No product matches.</li>' : "");
  }

  function renderGrid() {
    if (!GRID_MODE) return;
    const { term } = parse($("search").value);
    const found = term ? new Set(matches(term)) : null;
    const list = PRODUCTS.filter((p) => (!cat || p.category === cat) && (!found || found.has(p)));
    $("grid").innerHTML = list.map((p) => {
      const left = p.stock - (cart.get(p.id) || 0);
      const out = left <= 0;
      return `<button type="button" data-id="${p.id}" class="card flex flex-col items-start gap-1 p-3 text-left transition-colors ${out ? "opacity-50" : "hover:border-brand hover:bg-peach-soft"}">
        ${p.image ? `<img src="${esc(p.image)}" alt="" loading="lazy" class="mb-1 h-24 w-full rounded-xl object-cover">` : ""}
        <span class="text-xs font-bold text-ink-muted">${esc(p.barcode || p.code)}</span>
        <span class="font-bold leading-snug">${esc(p.name)}</span>
        <span class="mt-auto text-lg font-extrabold text-brand">${fmt(p.price)}</span>
        <span class="text-xs ${left <= 5 ? "font-bold text-danger" : "text-ink-muted"}">${out ? "Out of stock" : left + " " + esc(p.unit) + " left"}</span>
      </button>`;
    }).join("");
    $("empty").classList.toggle("hidden", list.length > 0);
  }

  let audio;
  function beep(ok) {
    if (!CFG.scanSound) return;
    try {
      audio = audio || new (window.AudioContext || window.webkitAudioContext)();
      const o = audio.createOscillator(), g = audio.createGain();
      o.frequency.value = ok ? 1100 : 220; o.type = ok ? "sine" : "square"; g.gain.value = 0.08;
      o.connect(g); g.connect(audio.destination); o.start(); o.stop(audio.currentTime + (ok ? 0.08 : 0.25));
    } catch { /* no audio available */ }
  }

  function scanMsg(msg) {
    beep(true);
    $("scanMsg").textContent = msg;
    $("scanMsg").classList.remove("hidden");
    clearTimeout(scanMsg.t);
    scanMsg.t = setTimeout(() => $("scanMsg").classList.add("hidden"), 2500);
  }

  // Tell the server (audit log) when an item leaves the basket. Never blocks the cashier.
  function logRemoval(kind, lines) {
    if (!lines.length) return;
    try {
      fetch("/cashier/removal", { method: "POST", headers: { "Content-Type": "application/json" }, keepalive: true,
        body: JSON.stringify({ kind, items: lines.map(([product_id, quantity]) => ({ product_id, quantity })) }) }).catch(() => {});
    } catch { /* logging must never stop a sale */ }
  }

  function add(id, n = 1) {
    const p = PRODUCTS.find((x) => x.id === id);
    if (!p) return false;
    const q = (cart.get(id) || 0) + n;
    if (q <= 0) { if (cart.has(id)) logRemoval("line_removed", [[id, cart.get(id)]]); cart.delete(id); if (sel === id) sel = null; }
    else if (n < 0) { logRemoval("line_reduced", [[id, -n]]); cart.set(id, q); sel = id; }
    else if (p.stock <= 0) { flashWarn(`${p.name} is out of stock.`); return false; }
    else if (q > p.stock) { flashWarn(`Only ${p.stock} ${p.unit} of ${p.name} in stock. You already have ${cart.get(id) || 0} in the sale.`); return false; }
    else { cart.set(id, q); sel = id; }
    render();
    return true;
  }

  function flashWarn(msg) {
    beep(false);
    window.notify("warning", msg);
  }

  function totals() {
    let subtotal = 0;
    for (const [id, q] of cart) subtotal += PRODUCTS.find((p) => p.id === id).price * q;
    subtotal = r2(subtotal);
    const discount = CFG.allowDiscount ? Math.min(Math.max(r2($("discount").value || 0), 0), r2(subtotal * CFG.maxDiscountPct / 100)) : 0;
    return { subtotal, total: r2(subtotal - discount) };
  }

  // Why the sale cannot be completed yet (null = ready). hint: short live text. title/text: shown in the alert.
  function saleProblem(total, paid, isCash) {
    if (cart.size === 0) return { hint: "Add at least one item to start a sale.", title: "The sale is empty", text: "Scan a barcode or search a product and add it first.", focus: "search" };
    if (isCash && !(paid > 0)) return { hint: "Enter the cash received (at least " + fmt(total) + ").", title: "Cash received is empty", text: "Type the amount the customer paid, or tap Exact. Total: " + fmt(total) + ".", focus: "amountPaid" };
    if (isCash && paid < total) return { hint: "Cash is short by " + fmt(total - paid) + ".", title: "Cash received is not enough", text: "Total " + fmt(total) + ", received " + fmt(paid) + ". The customer still owes " + fmt(total - paid) + ".", focus: "amountPaid" };
    return null;
  }

  function render() {
    $("cart").innerHTML = [...cart].map(([id, q]) => {
      const p = PRODUCTS.find((x) => x.id === id);
      return `<li data-line="${id}" class="flex items-center gap-2 py-2 ${id === sel ? "bg-peach-soft" : ""}">
        ${thumb(p, 40)}<div class="min-w-0 flex-1"><p class="truncate font-bold">${esc(p.name)}</p><p class="text-sm text-ink-muted">${fmt(p.price)} × ${q} = <strong class="text-ink">${fmt(p.price * q)}</strong></p></div>
        <button type="button" data-dec="${id}" class="btn-outline min-h-[36px] w-9 px-0">−</button>
        <span class="w-8 text-center font-bold">${q}</span>
        <button type="button" data-inc="${id}" class="btn-outline min-h-[36px] w-9 px-0">+</button>
      </li>`;
    }).join("");
    $("cartEmpty").classList.toggle("hidden", cart.size > 0);

    const { subtotal, total } = totals();
    $("subtotal").textContent = fmt(subtotal);
    $("total").textContent = fmt(total);
    const method = document.querySelector("input[name=payment_method]:checked").value;
    const isCash = method === "cash";
    $("cashBox").classList.toggle("hidden", !isCash);
    const paid = r2($("amountPaid").value || 0);
    $("change").textContent = fmt(Math.max(paid - total, 0));
    $("quick").innerHTML = [total, ...QUICK].filter((v, i, a) => v > 0 && (i === 0 || v > total) && a.indexOf(v) === i)
      .map((v) => `<button type="button" data-pay="${v}" class="chip min-h-[34px] border-line-strong px-3 text-sm">${v === total ? "Exact" : fmt(v)}</button>`).join("");
    const problem = saleProblem(total, paid, isCash);
    $("payBtn").classList.toggle("opacity-60", Boolean(problem));
    $("payHint").textContent = problem ? problem.hint : "";
    $("payHint").classList.toggle("text-danger", Boolean(problem));
    $("cartField").value = JSON.stringify([...cart].map(([product_id, quantity]) => ({ product_id, quantity })));
    renderGrid();
    renderResults();
  }

  function submitSearch() {
    const { qty, term } = parse($("search").value);
    if (!term) return;
    const pick = exact(term) || matches(term)[hi] || null;
    if (!pick) return flashWarn(`No product found for "${term}".`);
    if (add(pick.id, qty)) scanMsg(`Added ${qty} × ${pick.name}`);
    $("search").value = ""; hi = 0;
    render();
  }

  $("search").addEventListener("input", () => { hi = 0; render(); });
  $("search").addEventListener("keydown", (e) => {
    const { term } = parse($("search").value);
    const n = Math.min(matches(term).length, 8);
    if (e.key === "Enter") { e.preventDefault(); submitSearch(); }
    else if (e.key === "ArrowDown" && term) { e.preventDefault(); hi = n ? (hi + 1) % n : 0; renderResults(); }
    else if (e.key === "ArrowUp" && term) { e.preventDefault(); hi = n ? (hi - 1 + n) % n : 0; renderResults(); }
    else if (e.key === "Escape") { $("search").value = ""; hi = 0; render(); }
  });
  $("results").addEventListener("mousedown", (e) => {
    const li = e.target.closest("[data-id]"); if (!li) return;
    e.preventDefault();
    const { qty } = parse($("search").value);
    const p = PRODUCTS.find((x) => x.id === Number(li.dataset.id));
    if (add(p.id, qty)) scanMsg(`Added ${qty} × ${p.name}`);
    $("search").value = ""; hi = 0; render(); $("search").focus();
  });
  if (GRID_MODE) {
    $("grid").addEventListener("click", (e) => { const b = e.target.closest("[data-id]"); if (b) add(Number(b.dataset.id)); });
    $("cats").addEventListener("click", (e) => {
      const b = e.target.closest("[data-cat]"); if (!b) return;
      cat = b.dataset.cat;
      for (const c of $("cats").children) {
        const on = c === b;
        c.classList.toggle("bg-brand", on); c.classList.toggle("text-white", on); c.classList.toggle("border-brand", on);
        c.classList.toggle("bg-white", !on); c.classList.toggle("text-ink", !on); c.classList.toggle("border-line-strong", !on);
      }
      renderGrid();
    });
  }
  $("cart").addEventListener("click", (e) => {
    const inc = e.target.closest("[data-inc]"), dec = e.target.closest("[data-dec]"), line = e.target.closest("[data-line]");
    if (inc) add(Number(inc.dataset.inc), 1);
    else if (dec) add(Number(dec.dataset.dec), -1);
    else if (line) { sel = Number(line.dataset.line); render(); }
  });
  $("quick").addEventListener("click", (e) => { const b = e.target.closest("[data-pay]"); if (b) { $("amountPaid").value = b.dataset.pay; render(); } });
  $("discount").addEventListener("change", () => {
    let subtotal = 0;
    for (const [id, q] of cart) subtotal += PRODUCTS.find((p) => p.id === id).price * q;
    const cap = r2(subtotal * CFG.maxDiscountPct / 100);
    const v = r2($("discount").value || 0);
    if (v > cap) {
      $("discount").value = cap;
      flashWarn(cart.size ? "The discount is limited to " + CFG.maxDiscountPct + "% of the sale (" + fmt(cap) + ")." : "Add items before giving a discount.");
      render();
    }
  });
  for (const id of ["discount", "amountPaid"]) $(id).addEventListener("input", render);
  $("methods").addEventListener("change", render);
  function clearSale() { logRemoval("sale_cleared", [...cart]); cart.clear(); sel = null; $("amountPaid").value = ""; $("discount").value = 0; render(); $("search").focus(); }
  const keys = {
    search: () => { $("search").focus(); $("search").select(); },
    discount: () => { if (!CFG.allowDiscount) return flashWarn("Discounts are turned off in Settings."); $("discount").focus(); $("discount").select(); },
    cash: () => { const c = document.querySelector("input[value=cash]"); if (c) c.checked = true; render(); $("amountPaid").focus(); $("amountPaid").select(); },
    method: () => { const r = [...document.querySelectorAll("input[name=payment_method]")]; const i = r.findIndex((x) => x.checked); r[(i + 1) % r.length].checked = true; render(); },
    clear: async () => {
      if (!cart.size) return;
      const r = await Swal.fire({ icon: "question", title: "Clear this sale?", showCancelButton: true, confirmButtonText: "Clear", cancelButtonText: "Keep", reverseButtons: true, confirmButtonColor: "#B42318" });
      if (r.isConfirmed) clearSale();
    },
    pay: () => $("checkoutForm").requestSubmit()
  };
  const keymap = {};
  for (const [action, key] of Object.entries(CFG.shortcuts)) keymap[key] = keys[action];
  $("clear").addEventListener("click", () => keys.clear());
  $("checkoutForm").addEventListener("submit", (e) => {
    const { total } = totals();
    const isCash = document.querySelector("input[name=payment_method]:checked").value === "cash";
    const problem = saleProblem(total, r2($("amountPaid").value || 0), isCash);
    if (problem) {
      e.preventDefault();
      beep(false);
      Swal.fire({ icon: "warning", title: problem.title, text: problem.text, confirmButtonText: "OK", confirmButtonColor: "#C2410C" }).then(() => { $(problem.focus).focus(); });
      return;
    }
    $("payBtn").disabled = true; $("payBtn").textContent = "Saving…";
  });

  const SHORTCUTS = [
    ["10@112233", "10 pieces of barcode 112233"], ["Enter", "Add the typed or scanned item"], [CFG.shortcuts.search, "Search"], [CFG.shortcuts.discount, "Discount"], [CFG.shortcuts.cash, "Cash received"],
    [CFG.shortcuts.method, "Change payment method"], [CFG.shortcuts.clear, "Clear sale"], [CFG.shortcuts.pay, "Complete sale"], ["↑ ↓", "Select a cart line"], ["+ / −", "Change quantity"], ["Del", "Remove selected line"], ["Esc", "Clear search"]
  ];
  $("shortcutsBtn").addEventListener("click", () => Swal.fire({
    title: "Keyboard shortcuts", confirmButtonText: "Close", confirmButtonColor: "#C2410C", width: 460,
    html: '<table style="width:100%;text-align:left;font-size:15px">' + SHORTCUTS.map(([k, d]) => '<tr><td style="padding:5px 12px 5px 0;font-weight:800;white-space:nowrap">' + k + '</td><td style="padding:5px 0;color:#6B4F3F">' + d + '</td></tr>').join("") + "</table>"
  }));

  // Keyboard shortcuts (work from anywhere on the page)
  document.addEventListener("keydown", (e) => {
    if (Swal.isVisible()) return;
    const typing = ["INPUT", "TEXTAREA", "SELECT"].includes(document.activeElement.tagName);
    if (keymap[e.key]) { e.preventDefault(); keymap[e.key](); return; }
    const emptySearch = document.activeElement === $("search") ? !$("search").value : !typing;
    if (!emptySearch || !cart.size) return;
    const ids = [...cart.keys()];
    const i = Math.max(ids.indexOf(sel), 0);
    if (e.key === "ArrowDown") { e.preventDefault(); sel = ids[Math.min(i + 1, ids.length - 1)]; render(); }
    else if (e.key === "ArrowUp") { e.preventDefault(); sel = ids[Math.max(i - 1, 0)]; render(); }
    else if (e.key === "+" || e.key === "=") { e.preventDefault(); add(sel ?? ids[0], 1); }
    else if (e.key === "-") { e.preventDefault(); add(sel ?? ids[0], -1); }
    else if (e.key === "Delete") { e.preventDefault(); const id = sel ?? ids[0]; logRemoval("line_removed", [[id, cart.get(id)]]); cart.delete(id); sel = null; render(); }
  });
  // Settings: hide turned-off payment methods, pick the default, hide the discount row if discounts are off
  for (const [value, on] of [["cash", CFG.payCash], ["gcash", CFG.payGcash], ["card", CFG.payCard]]) {
    const input = document.querySelector("input[name=payment_method][value=" + value + "]");
    if (!on) input.closest("label").remove();
  }
  const def = document.querySelector("input[name=payment_method][value=" + CFG.defaultPayment + "]");
  if (def) def.checked = true;
  if (!CFG.allowDiscount) $("discount").closest(".flex").classList.add("hidden");
  render();
</script>
{{> pos-footer}}
