{{> pos-head}}
{{> nav}}
<main class="mx-auto w-full max-w-6xl flex-1 px-4 py-6 sm:px-6">
  {{> flash}}
  <div class="mb-4 flex flex-wrap items-end justify-between gap-3">
    <h1 class="text-2xl font-extrabold">Suppliers</h1>
    <a href="/suppliers/new" class="btn-primary">Add supplier</a>
  </div>
  <div class="card overflow-x-auto">
    <table class="w-full text-left text-[15px]">
      <thead class="border-b border-line text-sm text-ink-muted"><tr>
        <th class="px-4 py-3">Code</th><th class="px-4 py-3">Name</th><th class="px-4 py-3">Contact</th><th class="px-4 py-3">Phone</th>
        <th class="px-4 py-3">Address</th><th class="px-4 py-3">Status</th><th class="px-4 py-3"></th></tr></thead>
      <tbody class="divide-y divide-line">
        {{#each suppliers}}
        <tr>
          <td class="px-4 py-3 font-bold">{{supplier_code}}</td>
          <td class="px-4 py-3">{{name}}</td>
          <td class="px-4 py-3">{{contact_person}}{{#if email}}<br><span class="text-sm text-ink-muted">{{email}}</span>{{/if}}</td>
          <td class="px-4 py-3">{{phone}}</td>
          <td class="px-4 py-3">{{address}}</td>
          <td class="px-4 py-3"><span class="badge {{badge status}}">{{status}}</span></td>
          <td class="px-4 py-3"><div class="flex justify-end gap-2">
            <a href="/suppliers/{{id}}/edit" class="btn-outline min-h-[36px] px-3 text-sm">Edit</a>
            <form action="/suppliers/{{id}}/toggle" method="POST"><button class="btn-outline min-h-[36px] px-3 text-sm">{{#if (eq status 'active')}}Deactivate{{else}}Activate{{/if}}</button></form>
          </div></td>
        </tr>
        {{else}}<tr><td colspan="7" class="px-4 py-8 text-center text-ink-muted">No suppliers yet.</td></tr>{{/each}}
      </tbody>
    </table>
  </div>
</main>
{{> pos-footer}}
