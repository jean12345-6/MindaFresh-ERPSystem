{{> pos-head}}
{{> nav}}
<style>
  .label-sheet { width: 62mm; padding: 3mm; background: #fff; color: #000; box-shadow: 0 0 0 1px #ccc; box-sizing: border-box; text-align: center; font-family: Arial, Helvetica, sans-serif; }
  .label-sheet .nm { font-size: 11pt; font-weight: 700; line-height: 1.15; max-height: 2.4em; overflow: hidden; }
  .label-sheet .pr { font-size: 15pt; font-weight: 800; margin: 1mm 0; }
  .label-sheet img { width: 100%; height: auto; display: block; }
  @media print {
    html, body { background: #fff !important; }
    .no-print { display: none !important; }
    main { padding: 0 !important; margin: 0 !important; max-width: none !important; }
    .label-sheet { box-shadow: none; margin: 0; break-after: page; }
    #labels { margin: 0 !important; } #labels > * { margin: 0 !important; }
    .label-sheet:last-child { break-after: auto; }
  }
</style>
<main class="mx-auto w-full max-w-3xl flex-1 px-4 py-6 sm:px-6">
  <div class="no-print">
    {{> flash}}
    <a href="/products/{{p.id}}/edit" class="text-sm font-bold text-brand">← {{p.product_code}}</a>
    <h1 class="mt-2 text-2xl font-extrabold">Barcode label</h1>
    <div class="mt-3 flex flex-wrap items-center gap-3">
      <label class="flex items-center gap-2 font-semibold">Copies <input id="copies" type="number" min="1" max="60" value="1" class="field h-11 w-24"></label>
      <button type="button" onclick="window.print()" class="btn-primary">Print label</button>
    </div>
    <p class="mt-2 text-sm text-ink-muted">Prints on a 62 mm wide label. {{#unless p.barcode}}This product has no barcode yet, so the label uses its product code.{{/unless}}</p>
  </div>
  <div id="labels" class="mt-4 space-y-2">
    <div class="label-sheet">
      <div class="nm">{{p.name}}</div>
      <div class="pr">{{peso p.selling_price}}</div>
      <img src="/barcode/{{code}}.svg?h=70" alt="Barcode {{code}}">
    </div>
  </div>
</main>
<script>
  // Browsers cannot print "as tall as the content", so the paper height is set to one label's height just before printing.
  (() => {
    const style = document.createElement("style"); document.head.appendChild(style);
    const fit = () => { const px = document.querySelector(".label-sheet").getBoundingClientRect().height; style.textContent = "@page { size: 62mm " + Math.ceil(px * 25.4 / 96) + "mm; margin: 0; }"; };
    window.addEventListener("beforeprint", fit); window.addEventListener("load", fit); fit();
  })();
  document.getElementById("copies").addEventListener("input", (e) => {
    const n = Math.min(Math.max(parseInt(e.target.value, 10) || 1, 1), 60), box = document.getElementById("labels");
    while (box.children.length < n) box.appendChild(box.children[0].cloneNode(true));
    while (box.children.length > n) box.lastChild.remove();
  });
</script>
{{> pos-footer}}
