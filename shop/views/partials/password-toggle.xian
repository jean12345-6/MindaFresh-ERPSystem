{{!-- Show / hide password. Any button with data-toggle-for="<input id>" switches that input.
     The icon shows the password's state: eye with a slash = hidden, open eye = shown. --}}
<script>
  (function () {
    var EYE = '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12z"/><circle cx="12" cy="12" r="3"/>';
    var EYE_OFF = '<path d="M10.6 5.1A10.4 10.4 0 0 1 12 5c6.4 0 10 7 10 7a17.6 17.6 0 0 1-2.9 3.9"/>' +
      '<path d="M6.6 6.6C3.9 8.3 2 12 2 12s3.6 7 10 7a9.7 9.7 0 0 0 5.4-1.6"/>' +
      '<path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/><path d="M3 3l18 18"/>';

    function paint(btn, input) {
      var shown = input.type === "text";
      var svg = btn.querySelector("svg");
      if (svg) svg.innerHTML = shown ? EYE : EYE_OFF;
      btn.setAttribute("aria-pressed", String(shown));
      btn.setAttribute("aria-label", shown ? "Hide password" : "Show password");
    }

    document.querySelectorAll("[data-toggle-for]").forEach(function (btn) {
      var input = document.getElementById(btn.getAttribute("data-toggle-for"));
      if (!input) return;
      paint(btn, input); // start with the slashed eye: the password is hidden
      btn.addEventListener("click", function () {
        input.type = input.type === "password" ? "text" : "password";
        paint(btn, input);
      });
    });
  })();
</script>
