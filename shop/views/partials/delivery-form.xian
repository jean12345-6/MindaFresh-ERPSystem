{{!-- Mark delivered with a proof-of-delivery photo. Params: action (form URL), code (order code).
     On a phone, "capture" opens the back camera; on a laptop it opens the file picker. --}}
<form action="{{action}}" method="POST" enctype="multipart/form-data" class="flex flex-col gap-2.5">
  <label for="proof-{{code}}" class="text-sm font-bold">Proof of delivery photo <span class="font-normal text-ink-muted">(JPG, PNG or WebP, up to 2 MB)</span></label>
  <input id="proof-{{code}}" type="file" name="photo" accept="image/jpeg,image/png,image/webp" capture="environment" required
         class="block w-full min-w-0 rounded-xl border border-line-strong bg-white text-sm file:mr-3 file:min-h-[44px] file:cursor-pointer file:border-0 file:bg-peach-soft file:px-4 file:font-semibold file:text-ink">
  <button type="submit" class="btn-primary">Mark delivered</button>
</form>
