
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <title>Today Board | MindaFresh Attendance</title>

  <link rel="stylesheet" href="/style.css">
</head>

<body>
  <div class="app-shell">

    <!-- SIDEBAR -->
    <aside class="sidebar">

      <a class="brand" href="/dashboard">
        <img src="/mindafresh-logo.png" alt="MindaFresh logo">
        <span>
          <b>MindaFresh</b>
          <small>Attendance</small>
        </span>
      </a>

      <div class="side-heading">
        ATTENDANCE MANAGEMENT
      </div>

      <div class="side-heading workspace">
        WORKSPACE
      </div>

      <nav class="side-nav">

        <a class="side-link active" href="/dashboard">
          <span class="nav-icon">▦</span>
          <span>Dashboard</span>
        </a>

        <a class="side-link" href="/kiosk">
          <span class="nav-icon">◷</span>
          <span>Attendance Kiosk</span>
        </a>

        <a class="side-link" href="/logs">
          <span class="nav-icon">▤</span>
          <span>Attendance Logs</span>
        </a>

        <a class="side-link" href="/dtr">
          <span class="nav-icon">▣</span>
          <span>Daily Time Record</span>
        </a>

        <a class="side-link" href="/summary">
          <span class="nav-icon">▥</span>
          <span>Period Summary</span>
        </a>

        <a class="side-link" href="/holidays">
          <span class="nav-icon">▧</span>
          <span>Holidays</span>
        </a>

        <a class="side-link" href="/qr-cards">
          <span class="nav-icon">▦</span>
          <span>Employee QR Cards</span>
        </a>

      </nav>

      <div class="side-bottom">
        <span class="online-dot"></span>
        Part of MindaFresh ERP
        <small>One database. One connected team.</small>
      </div>

    </aside>

    <!-- MAIN AREA -->
    <div class="app-area">

      <!-- TOPBAR -->
      <header class="topbar">

        <div class="breadcrumbs">
          MindaFresh ERP
          <span>/</span>
          <b>Today Board</b>
        </div>

        <div class="account">

          {{#if staff}}

            <div class="avatar">M</div>

            <div class="account-info">
              <strong>{{staff.username}}</strong>
              <small>{{staff.role}}</small>
            </div>

            <form
              class="inline"
              method="post"
              action="/logout"
            >
              <button class="outline small-btn" type="submit">
                Logout
              </button>
            </form>

          {{else}}

            <a class="outline login-link" href="/login">
              Staff Login
            </a>

          {{/if}}

        </div>

      </header>

      <!-- DASHBOARD CONTENT -->
      <main class="content">

        <!-- PAGE HEADER -->
        <div class="page-intro">

          <div>
            <div class="eyebrow">
              MINDAFRESH / ATTENDANCE
            </div>

            <h1>Today Board</h1>

            <p class="intro-sub">
              Monitor employee time records and attendance
              activity in one workspace.
            </p>
          </div>

          <a href="/logs" class="action-link">
            View attendance logs
          </a>

        </div>

        <!-- ATTENDANCE STATISTICS -->
        <div class="stats">

          <div class="stat">
            Present
            <strong>{{counts.present}}</strong>
          </div>

          <div class="stat">
            Late
            <strong>{{counts.late}}</strong>
          </div>

          <div class="stat">
            Absent
            <strong>{{counts.absent}}</strong>
          </div>

          <div class="stat">
            On leave
            <strong>{{counts.on_leave}}</strong>
          </div>

          <div class="stat">
            Not yet in
            <strong>{{counts.not_yet_in}}</strong>
          </div>

        </div>

        <!-- ACTIVE EMPLOYEES TABLE -->
        <div class="card scroll">

          <h2>Active employees</h2>

          <table>

            <thead>
              <tr>
                <th>Code</th>
                <th>Employee</th>
                <th>Department</th>
                <th>Status</th>
                <th>Time in</th>
                <th>Lunch out</th>
                <th>Lunch in</th>
                <th>Time out</th>
              </tr>
            </thead>

            <tbody>

              {{#each rows}}

                <tr>
                  <td>{{employee_code}}</td>
                  <td>{{name}}</td>
                  <td>{{department}}</td>
                  <td>{{display_status}}</td>
                  <td>{{datetime time_in}}</td>
                  <td>{{datetime lunch_out}}</td>
                  <td>{{datetime lunch_in}}</td>
                  <td>{{datetime time_out}}</td>
                </tr>

              {{/each}}

            </tbody>

          </table>

        </div>

      </main>

    </div>

  </div>
</body>
</html>
