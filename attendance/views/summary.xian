
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Period Summary | MindaFresh Attendance</title>
  <link rel="stylesheet" href="/style.css">

  <style>
    /* PERIOD SUMMARY */
    .summary-toolbar {
      display: flex;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 12px;
      margin: 22px 0;
    }

    .summary-filter {
      display: flex;
      flex: 1;
      flex-wrap: wrap;
      align-items: flex-end;
      gap: 12px;
    }

    .summary-date-field {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .summary-date-field label {
      color: #765d50;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: .5px;
      text-transform: uppercase;
    }

    .summary-date-field input {
      height: 43px;
      min-width: 160px;
      padding: 0 13px;
      border: 1px solid #e8d4c7;
      border-radius: 10px;
      background: #fff;
      color: #432b20;
      font: inherit;
      font-size: 13px;
      box-sizing: border-box;
    }

    .summary-date-field input:focus {
      outline: none;
      border-color: #cf3b00;
      box-shadow: 0 0 0 3px rgba(207,59,0,.08);
    }

    .summary-btn {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      min-height: 43px;
      padding: 0 18px;
      border: 1px solid #cf3b00;
      border-radius: 10px;
      background: #cf3b00;
      color: #fff;
      font: inherit;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
      transition: background .2s;
    }

    .summary-btn:hover {
      background: #b63300;
    }

    .summary-btn.secondary {
      border-color: #e9cdbd;
      background: #fffaf7;
      color: #a93608;
    }

    .summary-btn.secondary:hover {
      background: #fff0e6;
    }

    .summary-table-card {
      padding: 20px;
      border: 1px solid #e9dcd2;
      border-radius: 16px;
      background: #fff;
      box-shadow: 0 5px 20px rgba(60,38,25,.035);
    }

    .summary-table-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 18px;
    }

    .summary-table-header h2 {
      margin: 0 0 5px;
      color: #39251b;
      font-size: 17px;
    }

    .summary-table-header p {
      margin: 0;
      color: #94796b;
      font-size: 12px;
    }

    .summary-record-badge {
      padding: 8px 12px;
      border-radius: 20px;
      background: #fff0e6;
      color: #b63b08;
      font-size: 12px;
      font-weight: 700;
      white-space: nowrap;
    }

    .summary-table-wrap {
      width: 100%;
      overflow-x: auto;
    }

    .summary-table {
      width: 100%;
      min-width: 900px;
      border-collapse: collapse;
      font-size: 12px;
    }

    .summary-table th {
      padding: 15px 13px;
      background: #fff5ef;
      border-bottom: 1px solid #efdfd4;
      color: #765546;
      font-size: 11px;
      font-weight: 700;
      text-align: left;
      white-space: nowrap;
    }

    .summary-table td {
      padding: 15px 13px;
      border-bottom: 1px solid #f0e7e1;
      color: #483429;
      white-space: nowrap;
    }

    .summary-table tbody tr:hover {
      background: #fffaf6;
    }

    .summary-table th:not(:first-child),
    .summary-table td:not(:first-child) {
      text-align: center;
    }

    .summary-table .employee-name {
      font-weight: 700;
      color: #39251b;
    }

    .summary-empty {
      padding: 32px 15px !important;
      text-align: center !important;
      color: #94796b !important;
    }

    /* PAGINATION */
    .summary-pagination {
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 15px;
      margin-top: 20px;
      padding-top: 18px;
      border-top: 1px solid #f0e4dc;
    }

    .summary-page-info {
      color: #846a5c;
      font-size: 12px;
    }

    .summary-page-buttons {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 6px;
    }

    .summary-page-btn {
      min-width: 35px;
      height: 35px;
      padding: 0 11px;
      border: 1px solid #ead7cb;
      border-radius: 8px;
      background: #fff;
      color: #684a3b;
      font: inherit;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .summary-page-btn:hover:not(:disabled) {
      background: #fff0e6;
      border-color: #cf3b00;
      color: #cf3b00;
    }

    .summary-page-btn.active {
      background: #cf3b00;
      border-color: #cf3b00;
      color: #fff;
    }

    .summary-page-btn:disabled {
      opacity: .4;
      cursor: not-allowed;
    }

    .summary-alert {
      margin: 15px 0;
      padding: 13px 16px;
      border-radius: 10px;
      font-size: 13px;
    }

    .summary-alert.success {
      background: #e8f6ec;
      color: #21683b;
      border: 1px solid #cce8d4;
    }

    .summary-alert.error {
      background: #fff0ec;
      color: #aa321b;
      border: 1px solid #f1d2c8;
    }

    /* MODAL */
    .summary-dialog {
      position: fixed;
      width: min(440px, calc(100vw - 32px));
      max-width: 100%;
      max-height: calc(100vh - 32px);
      margin: auto;
      padding: 28px;
      border: 1px solid #f0d7c8;
      border-radius: 20px;
      background: #fffdfb;
      color: #39251b;
      box-shadow: 0 25px 75px rgba(39,22,13,.25);
      font-family: inherit;
      box-sizing: border-box;
      overflow-y: auto;
    }

    .summary-dialog::backdrop {
      background: rgba(36,23,16,.52);
      backdrop-filter: blur(3px);
    }

    .summary-modal-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 54px;
      height: 54px;
      margin-bottom: 18px;
      border-radius: 15px;
      background: #fff0e6;
      color: #cf3b00;
      font-size: 25px;
      font-weight: 700;
    }

    .summary-dialog h2 {
      margin: 0 0 10px;
      color: #39251b;
      font-size: 22px;
      line-height: 1.3;
    }

    .summary-dialog p {
      margin: 0;
      color: #846a5c;
      font-size: 13px;
      line-height: 1.7;
    }

    .summary-modal-actions {
      display: flex;
      justify-content: flex-end;
      gap: 10px;
      margin-top: 25px;
    }

    .summary-modal-actions form {
      margin: 0;
    }

    .summary-modal-actions button {
      min-height: 42px;
      padding: 10px 17px;
      border-radius: 9px;
      font: inherit;
      font-size: 12px;
      font-weight: 700;
      cursor: pointer;
    }

    .summary-cancel {
      border: 1px solid #e8d3c6;
      background: #fff;
      color: #684a3b;
    }

    .summary-confirm {
      border: 1px solid #cf3b00;
      background: #cf3b00;
      color: #fff;
    }

    .summary-confirm:hover {
      background: #b63200;
    }

    @media (max-width: 650px) {
      .summary-toolbar,
      .summary-filter {
        flex-direction: column;
        align-items: stretch;
      }

      .summary-date-field,
      .summary-date-field input,
      .summary-btn,
      .summary-toolbar > form {
        width: 100%;
      }

      .summary-table-card {
        padding: 15px;
      }

      .summary-table-header {
        align-items: flex-start;
        flex-direction: column;
      }

      .summary-pagination {
        flex-direction: column;
        align-items: flex-start;
      }

      .summary-dialog {
        padding: 23px;
      }
    }
  </style>
</head>

<body>
<div class="app-shell">

  <!-- SIDEBAR -->
  <aside class="sidebar">
    <a class="brand" href="/dashboard">
      <img src="/mindafresh-logo.png" alt="MindaFresh logo">
      <span>
        <b>MindaFresh</b>
        <small>Attendance</small>
      </span>
    </a>

    <div class="side-heading">
      ATTENDANCE MANAGEMENT
    </div>

    <div class="side-heading workspace">
      WORKSPACE
    </div>

    <nav class="side-nav">
      <a class="side-link" href="/dashboard">
        <span class="nav-icon">▦</span>
        <span>Dashboard</span>
      </a>

      <a class="side-link" href="/kiosk">
        <span class="nav-icon">◷</span>
        <span>Attendance Kiosk</span>
      </a>

      <a class="side-link" href="/logs">
        <span class="nav-icon">▤</span>
        <span>Attendance Logs</span>
      </a>

      <a class="side-link" href="/dtr">
        <span class="nav-icon">▣</span>
        <span>Daily Time Record</span>
      </a>

      <a class="side-link active" href="/summary">
        <span class="nav-icon">▥</span>
        <span>Period Summary</span>
      </a>

      <a class="side-link" href="/holidays">
        <span class="nav-icon">▧</span>
        <span>Holidays</span>
      </a>

      <a class="side-link" href="/qr-cards">
        <span class="nav-icon">▦</span>
        <span>Employee QR Cards</span>
      </a>
    </nav>

    <div class="side-bottom">
      <span class="online-dot"></span>
      Part of MindaFresh ERP
      <small>One database. One connected team.</small>
    </div>
  </aside>

  <!-- MAIN AREA -->
  <div class="app-area">

    <header class="topbar">
      <div class="breadcrumbs">
        MindaFresh ERP
        <span>/</span>
        <b>Period Summary</b>
      </div>

      <div class="account">
        {{#if staff}}
          <div class="avatar">M</div>

          <div class="account-info">
            <strong>{{staff.username}}</strong>
            <small>{{staff.role}}</small>
          </div>

          <button
            type="button"
            class="outline small-btn"
            id="open-logout"
          >
            Logout
          </button>
        {{else}}
          <a class="outline login-link" href="/login">
            Staff Login
          </a>
        {{/if}}
      </div>
    </header>

    <main class="content">

      <!-- PAGE TITLE -->
      <div class="page-intro">
        <div>
          <div class="eyebrow">
            MINDAFRESH / ATTENDANCE
          </div>

          <h1>Period Summary</h1>

          <p class="intro-sub">
            Review employee attendance, late records,
            absences, undertime, and total working hours.
          </p>
        </div>
      </div>

      <!-- DATE FILTERS -->
      <div class="summary-toolbar">

        <form
          class="summary-filter"
          method="get"
          action="/summary"
          id="summary-filter"
        >
          <div class="summary-date-field">
            <label for="date-from">FROM DATE</label>
            <input
              id="date-from"
              type="date"
              name="from"
              value="{{from}}"
              required
            >
          </div>

          <div class="summary-date-field">
            <label for="date-to">TO DATE</label>
            <input
              id="date-to"
              type="date"
              name="to"
              value="{{to}}"
              required
            >
          </div>

          <button class="summary-btn" type="submit">
            Show Summary
          </button>
        </form>

        <button
          class="summary-btn secondary"
          type="button"
          id="open-close-days"
        >
          Close Days
        </button>
      </div>

      <!-- CLOSE DAYS POST FORM -->
      <form
        method="post"
        action="/summary/close-days"
        id="close-days-form"
      >
        <input type="hidden" name="from" value="{{from}}">
        <input type="hidden" name="to" value="{{to}}">
      </form>

      <!-- STATUS MESSAGES -->
      {{#if closed}}
        <div class="summary-alert success" role="status">
          Close Days completed.
          New attendance records: {{closed}}
        </div>
      {{/if}}

      {{#if error}}
        <div class="summary-alert error" role="alert">
          Close Days error: {{error}}
        </div>
      {{/if}}

      <!-- SUMMARY TABLE -->
      <div class="summary-table-card">

        <div class="summary-table-header">
          <div>
            <h2>Employee Attendance Summary</h2>
            <p>
              Attendance overview for the selected date range
            </p>
          </div>

          <span class="summary-record-badge" id="summary-total">
            0 Employees
          </span>
        </div>

        <div class="summary-table-wrap">
          <table class="summary-table" id="summary-table">
            <thead>
              <tr>
                <th>Employee</th>
                <th>Present</th>
                <th>Late Days</th>
                <th>Absent</th>
                <th>Leave</th>
                <th>Late Min</th>
                <th>Undertime Min</th>
                <th>Hours</th>
              </tr>
            </thead>

            <tbody id="summary-tbody">
              {{#each rows}}
                <tr class="summary-data-row">
                  <td class="employee-name">
                    {{employee_name}}
                  </td>
                  <td>{{days_present}}</td>
                  <td>{{days_late}}</td>
                  <td>{{days_absent}}</td>
                  <td>{{days_on_leave}}</td>
                  <td>{{total_late_minutes}}</td>
                  <td>{{total_undertime_minutes}}</td>
                  <td>{{total_hours_worked}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>
        </div>

        <!-- PAGINATION -->
        <div class="summary-pagination">
          <div class="summary-page-info" id="summary-page-info">
            Showing 0 records
          </div>

          <div
            class="summary-page-buttons"
            id="summary-page-buttons"
            aria-label="Summary pagination"
          ></div>
        </div>

      </div>
    </main>
  </div>
</div>

<!-- CLOSE DAYS MODAL -->
<dialog
  id="close-days-dialog"
  class="summary-dialog"
  aria-labelledby="close-days-title"
>
  <div class="summary-modal-icon">!</div>

  <h2 id="close-days-title">Close Missing Workdays?</h2>

  <p>
    This action will create attendance records for
    missing past workdays within the selected date range.
    Existing records will not be overwritten.
  </p>

  <div class="summary-modal-actions">
    <button
      type="button"
      class="summary-cancel"
      id="cancel-close-days"
    >
      Cancel
    </button>

    <button
      type="submit"
      form="close-days-form"
      class="summary-confirm"
      id="confirm-close-days"
    >
      Confirm Close Days
    </button>
  </div>
</dialog>

<!-- LOGOUT MODAL -->
<dialog
  id="logout-dialog"
  class="summary-dialog"
  aria-labelledby="logout-title"
>
  <div class="summary-modal-icon">↪</div>

  <h2 id="logout-title">Log out of MindaFresh?</h2>

  <p>
    Are you sure you want to log out?
    You will need to sign in again to access
    your Attendance ERP account.
  </p>

  <div class="summary-modal-actions">
    <button
      type="button"
      class="summary-cancel"
      id="cancel-logout"
    >
      Cancel
    </button>

    <form method="post" action="/logout">
      <button type="submit" class="summary-confirm">
        Log Out
      </button>
    </form>
  </div>
</dialog>

<script>
(() => {
  "use strict";

  /* PAGINATION */
  const rows = Array.from(
    document.querySelectorAll(
      "#summary-tbody .summary-data-row"
    )
  );

  const rowsPerPage = 10;
  const totalRecords = rows.length;
  const totalPages = Math.max(
    1,
    Math.ceil(totalRecords / rowsPerPage)
  );

  let currentPage = 1;

  const pageInfo = document.getElementById(
    "summary-page-info"
  );

  const pageButtons = document.getElementById(
    "summary-page-buttons"
  );

  const totalBadge = document.getElementById(
    "summary-total"
  );

  totalBadge.textContent =
    totalRecords + (
      totalRecords === 1
        ? " Employee"
        : " Employees"
    );

  function createPageButton(label, page, disabled, active) {
    const button = document.createElement("button");

    button.type = "button";
    button.className = "summary-page-btn";
    button.textContent = label;
    button.disabled = disabled;

    if (active) {
      button.classList.add("active");
      button.setAttribute("aria-current", "page");
    }

    button.addEventListener("click", () => {
      if (!disabled && page !== currentPage) {
        currentPage = page;
        renderPagination();
      }
    });

    return button;
  }

  function renderPagination() {
    const startIndex = (currentPage - 1) * rowsPerPage;
    const endIndex = Math.min(
      startIndex + rowsPerPage,
      totalRecords
    );

    rows.forEach((row, index) => {
      row.hidden = (
        index < startIndex ||
        index >= endIndex
      );

      row.style.display = row.hidden ? "none" : "";
    });

    if (totalRecords === 0) {
      pageInfo.textContent = "No employee records found.";
    } else {
      pageInfo.textContent =
        "Showing " +
        (startIndex + 1) +
        "–" +
        endIndex +
        " of " +
        totalRecords +
        " employees";
    }

    pageButtons.innerHTML = "";

    if (totalRecords === 0) {
      const tbody = document.getElementById(
        "summary-tbody"
      );

      if (!tbody.querySelector(".summary-empty-row")) {
        const emptyRow = document.createElement("tr");
        emptyRow.className = "summary-empty-row";

        const cell = document.createElement("td");
        cell.colSpan = 8;
        cell.className = "summary-empty";
        cell.textContent =
          "No attendance summary records for this date range.";

        emptyRow.appendChild(cell);
        tbody.appendChild(emptyRow);
      }

      return;
    }

    if (totalPages <= 1) return;

    pageButtons.appendChild(
      createPageButton(
        "Previous",
        currentPage - 1,
        currentPage === 1,
        false
      )
    );

    for (let page = 1; page <= totalPages; page++) {
      pageButtons.appendChild(
        createPageButton(
          String(page),
          page,
          false,
          page === currentPage
        )
      );
    }

    pageButtons.appendChild(
      createPageButton(
        "Next",
        currentPage + 1,
        currentPage === totalPages,
        false
      )
    );
  }

  renderPagination();

  /* DATE VALIDATION */
  const summaryFilter = document.getElementById(
    "summary-filter"
  );

  summaryFilter.addEventListener("submit", event => {
    const from = document.getElementById(
      "date-from"
    ).value;

    const to = document.getElementById(
      "date-to"
    ).value;

    if (from && to && from > to) {
      event.preventDefault();
      alert("From Date cannot be later than To Date.");
    }
  });

  /* CLOSE DAYS MODAL */
  const closeDaysDialog = document.getElementById(
    "close-days-dialog"
  );

  document.getElementById("open-close-days")
    .addEventListener("click", () => {
      const from = document.getElementById(
        "date-from"
      ).value;

      const to = document.getElementById(
        "date-to"
      ).value;

      if (!from || !to || from > to) {
        alert("Please select a valid date range.");
        return;
      }

      const closeForm = document.getElementById(
        "close-days-form"
      );

      closeForm.elements.from.value = from;
      closeForm.elements.to.value = to;

      closeDaysDialog.showModal();
    });

  document.getElementById("cancel-close-days")
    .addEventListener("click", () => {
      closeDaysDialog.close();
    });

  /* LOGOUT MODAL */
  const logoutDialog = document.getElementById(
    "logout-dialog"
  );

  const openLogout = document.getElementById(
    "open-logout"
  );

  if (openLogout) {
    openLogout.addEventListener("click", () => {
      logoutDialog.showModal();
    });
  }

  document.getElementById("cancel-logout")
    .addEventListener("click", () => {
      logoutDialog.close();
    });

  /* CLOSE MODALS WHEN CLICKING OUTSIDE */
  [closeDaysDialog, logoutDialog].forEach(dialog => {
    dialog.addEventListener("click", event => {
      if (event.target === dialog) {
        dialog.close();
      }
    });
  });
})();
</script>
</body>
</html>
