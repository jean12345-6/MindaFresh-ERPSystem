<!doctype html>
<html lang="en">
  {{> head}}
  <body class="antialiased">
    {{> sidebar}}
    <div class="sidebar-backdrop" data-sidebar-close></div>
    <div class="workspace">
      {{> headerBar}}
      <main class="container" id="main-content" tabindex="-1">
        {{> messages}}
        {{> pages/profile}}
      </main>
      {{> footer}}
    </div>
    {{> scripts}}
  </body>
</html>
