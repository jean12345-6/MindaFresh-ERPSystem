<!doctype html>
<html lang="en">
  {{> hr-head}}
  <body class="antialiased">
    {{> sidebar}}
    <div class="sidebar-backdrop" data-sidebar-close></div>
    <div class="workspace">
      {{> headerBar}}
      <main class="container" id="main-content" tabindex="-1">
        {{> messages}}
        {{> pages/dashboard}}
      </main>
      {{> hr-footer}}
    </div>
    {{> scripts}}
  </body>
</html>
