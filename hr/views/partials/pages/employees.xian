<div class="page-heading">
  <div>
    <h1>Employees</h1>
    <p>Grouped by department, with employees sorted A–Z.</p>
  </div>

  <div class="actions">
    <a href="/reports/employees/export" class="btn">
      Export CSV
    </a>

    {{#if canManageHR}}
      <button
        type="button"
        class="btn primary"
        data-open="addEmployeeDialog"
      >
        Add employee
      </button>
    {{/if}}
  </div>
</div>

<section class="panel">
  <form class="filter-row" action="/employees" method="get">
    <input
      aria-label="Search employees"
      name="search"
      value="{{search}}"
      placeholder="Search name, code, position or department"
    />

    <select aria-label="Filter by status" name="status">
      <option value="">All statuses</option>
      <option value="active" {{selected status "active"}}>
        Active
      </option>
      <option value="inactive" {{selected status "inactive"}}>
        Inactive
      </option>
      <option value="resigned" {{selected status "resigned"}}>
        Resigned
      </option>
    </select>

    <button class="btn" type="submit">Search</button>
    <a class="text-link" href="/employees">Clear</a>
  </form>
</section>

{{#each employeeDepartments}}
  <section class="panel">
    <div class="panel-heading">
      <h2>
        {{department_name}}
        <span class="badge">{{employee_count}}</span>
      </h2>
      <span class="muted">Employees sorted by last name</span>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Employee code</th>
            <th scope="col">Name</th>
            <th scope="col">Position</th>
            <th scope="col">Employment</th>
            <th scope="col" class="amount">Daily rate</th>
            <th scope="col">Status</th>
            <th scope="col">Action</th>
          </tr>
        </thead>

        <tbody>
          {{#each employees}}
            <tr>
              <td>{{employee_code}}</td>
              <td>
                <strong>{{full_name}}</strong>
                <small>{{email}}</small>
              </td>
              <td>{{position}}</td>
              <td>{{employment_type}}</td>
              <td class="amount">{{money daily_rate}}</td>
              <td><span class="badge">{{status}}</span></td>
              <td>
                {{#if @root.canManageHR}}
                  <a
                    class="text-link"
                    href="/employees/{{id}}/edit"
                  >
                    Edit
                  </a>
                {{else}}
                  <span class="muted">View only</span>
                {{/if}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
{{else}}
  <section class="panel">
    <p class="empty">No matching employees.</p>
  </section>
{{/each}}

{{#if canManageHR}}
  {{> modals/employeeDialog}}
{{/if}}