<div class="page-heading">
  <div>
    <h1>Employees</h1>
    <p>One employee master record shared across all MindaFresh modules.</p>
  </div>
  <div class="actions">
    <a href="/reports/employees/export" class="btn">Export CSV</a>{{#if
    canManageHR}}<a href="/employees/create" class="btn primary">Add employee</a
    >{{/if}}
  </div>
</div>
<section class="panel">
  <form class="filter-row" action="/employees" method="get">
    <input
      aria-label="Search employees"
      name="search"
      value="{{search}}"
      placeholder="Search name, code, position or department"
    /><select aria-label="Filter by status" name="status">
      <option value="">All statuses</option>
      <option value="active" {{selected status "active"}}>Active</option>
      <option value="inactive" {{selected status "inactive"}}>Inactive</option>
      <option value="resigned" {{selected status "resigned"}}>Resigned</option></select
    ><button class="btn">Search</button
    ><a class="text-link" href="/employees">Clear</a>
  </form>
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th>Employee code</th>
          <th>Name</th>
          <th>Department</th>
          <th>Position</th>
          <th>Employment</th>
          <th class="amount">Daily rate</th>
          <th>Status</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {{#each employees}}
        <tr>
          <td>{{employee_code}}</td>
          <td><strong>{{full_name}}</strong><small>{{email}}</small></td>
          <td>{{department}}</td>
          <td>{{position}}</td>
          <td>{{employment_type}}</td>
          <td class="amount">{{money daily_rate}}</td>
          <td><span class="badge">{{status}}</span></td>
          <td>
            {{#if @root.canManageHR}}<a
              class="text-link"
              href="/employees/{{id}}/edit"
              >Edit</a
            >{{/if}}
          </td>
        </tr>
        {{else}}
        <tr>
          <td colspan="8" class="empty">No matching employees.</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </div>
</section>
