<div class="page-heading">
  <div>
    <h1>Departments</h1>
    <p>Manage the departments used by your employee records.</p>
  </div>
</div>
<section class="panel">
  <div class="panel-heading"><h2>Add department</h2></div>
  <form method="post" action="/departments" class="inline-form">
    <input type="hidden" name="_csrf" value="{{csrf}}" /><input
      type="hidden"
      name="return_to"
      value="/departments"
    /><input
      aria-label="Department name"
      name="name"
      placeholder="Department name"
      required
      maxlength="100"
    /><button class="btn primary">Add department</button>
  </form>
</section>
<section class="panel">
  <div class="panel-heading"><h2>Department directory</h2></div>
  {{#each departments}}
  <form
    class="inline-form divided"
    method="post"
    action="/departments/{{id}}/update"
  >
    <input type="hidden" name="_csrf" value="{{@root.csrf}}" /><input
      type="hidden"
      name="return_to"
      value="/departments"
    /><span class="code">{{department_code}}</span
    ><input
      aria-label="Edit department name"
      name="name"
      value="{{name}}"
      required
      maxlength="100"
    /><button class="btn">Save</button>
  </form>
  {{else}}
  <div class="empty">No departments yet.</div>
  {{/each}}
</section>
