<div class="page-heading">
  <div><h1>Attendance / Daily Time Record</h1>
    <p>Cutoff: {{date start}} – {{date end}}. Employees are sorted A–Z by last name.</p>
  </div>
</div>
{{> forms/attendanceFilter}}
{{#each attendanceGroups}}
<section class="panel">
  <div class="panel-heading">
    <div><h2>{{last_name}}, {{first_name}}</h2><p class="muted">{{employee_code}} · {{department}}</p></div>
    <span class="muted">{{date @root.start}} – {{date @root.end}}</span>
  </div>
  <div class="table-wrap"><table>
    <thead><tr><th>Present days</th><th>Late days</th><th>Absent days</th><th>Leave days</th><th>Late minutes</th><th>Undertime minutes</th><th>Overtime</th><th>Regular hours</th></tr></thead>
    <tbody><tr><td>{{days_present}}</td><td>{{days_late}}</td><td>{{days_absent}}</td><td>{{days_on_leave}}</td><td>{{late_minutes}}</td><td>{{undertime_minutes}}</td><td>{{overtime_display}}</td><td>{{hours_worked_display}}</td></tr></tbody>
  </table></div>
  <div class="signature-lines"><span>Employee signature</span><span>Verified by</span></div>
</section>
{{else}}
<section class="panel"><p class="empty">No employees for this cutoff.</p></section>
{{/each}}
