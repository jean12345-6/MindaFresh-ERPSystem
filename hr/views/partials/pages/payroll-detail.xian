<div class="page-heading">
  <div>
    <h1>{{run.payroll_code}}</h1>
    <p>
      {{date run.period_start}} – {{date run.period_end}} ·
      {{run.employee_count}} employees · {{run.display_status}}
    </p>
  </div>
  <a class="btn" href="/payroll">Back to payroll</a>
</div>
{{#if run.is_draft}}
<div class="note">
  Review all payslips. Recompute the draft if attendance, leave or employee
  rates changed. Approval locks this run.
</div>
{{else}}
<div class="note">
  This payroll is approved and locked. Accounting owns journal posting and
  salary release.
</div>
{{/if}}
{{#each payrollDepartments}}
  <section class="panel">
    <div class="panel-heading">
      <h2>
        {{department_name}}
        <span class="badge">{{employee_count}}</span>
      </h2>
      <span class="muted">Employees sorted by last name</span>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th scope="col">Employee</th>
            <th scope="col">Worked</th>
            <th scope="col">Paid leave</th>
            <th scope="col">Holiday</th>
            <th scope="col">Late / undertime</th>
            <th scope="col">OT minutes</th>
            <th scope="col" class="amount">OT pay</th>
            <th scope="col" class="amount">Gross</th>
            <th scope="col" class="amount">Net</th>
            <th scope="col">Action</th>
          </tr>
        </thead>

        <tbody>
          {{#each employees}}
            <tr>
              <td>
                <strong>{{employee_name}}</strong>
                <small>{{employee_code}}</small>
              </td>
              <td>{{days_worked}} days</td>
              <td>{{paid_leave_days}}</td>
              <td>{{paid_holiday_days}}</td>
              <td>
                {{late_minutes}} / {{undertime_minutes}} min
              </td>
              <td>{{overtime_minutes}}</td>
              <td class="amount">{{money overtime_pay}}</td>
              <td class="amount">{{money gross_pay}}</td>
              <td class="amount">{{money net_pay}}</td>
              <td>
                <a
                  href="/payslips/{{@root.run.id}}/{{employee_id}}"
                  class="text-link"
                >
                  Payslip
                </a>
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </section>
{{else}}
  <section class="panel">
    <p class="empty">No employee calculations for this run.</p>
  </section>
{{/each}}

<section class="panel">
  <div class="panel-total">
    <strong>Total net payroll</strong>
    <strong>{{money run.total_net}}</strong>
  </div>
</section>
{{#if run.is_draft}}
<div class="actions right">
  {{#if canManageHR}}
  <form method="post" action="/payroll/{{run.id}}/recompute">
    <input type="hidden" name="_csrf" value="{{csrf}}" /><input
      type="hidden"
      name="return_to"
      value="/payroll"
    /><button class="btn">Recompute draft</button>
  </form>
  {{/if}}{{#if isAdmin}}
  <form
    method="post"
    action="/payroll/{{run.id}}/approve"
    data-confirm="Approve and lock this payroll? Review every payslip first."
  >
    <input type="hidden" name="_csrf" value="{{csrf}}" /><input
      type="hidden"
      name="return_to"
      value="/payroll"
    /><button class="btn primary">Approve payroll</button>
  </form>
  {{/if}}
</div>
{{/if}}
