<main class="login-container"><section class="panel login-panel"><a class="brand" href="/login"><img class="brand-logo" src="/images/mindafresh-logo.svg" alt="MindaFresh logo"><strong>MindaFresh <span>PeoplePay</span></strong></a><h1>Sign in</h1><p class="muted">Use your shared MindaFresh staff account.</p>{{> messages}}<form method="post" action="/login"><input type="hidden" name="_csrf" value="{{csrf}}"><input type="hidden" name="return_to" value="/login"><label>Username<input name="username" autocomplete="username" required maxlength="50"></label><label>Password<input type="password" name="password" autocomplete="current-password" required maxlength="72"></label><button class="btn primary full-button">Sign in</button></form><p class="muted">Need an account? Contact your administrator.</p></section></main>
