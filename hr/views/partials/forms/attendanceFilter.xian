<form method="get" action="/attendance" class="attendance-filter"><label>From<input type="date" name="start" value="{{start}}" required></label><label>Through<input type="date" name="end" value="{{end}}" required></label><label>Employee<select name="employee_id"><option value="">All employees</option>{{#each employeesForFilter}}<option value="{{id}}" {{#if selected}}selected{{/if}}>{{employee_code}} · {{full_name}}</option>{{/each}}</select></label><button class="btn primary" type="submit">Apply filters</button><button class="btn" type="button" data-print>Print DTR</button></form>
