<template id="tablePaginationTemplate">
  <nav class="table-pagination" aria-label="Table pagination">
    <div class="pagination-options"><label>Rows per page <select data-page-size><option value="10">10</option><option value="25">25</option><option value="50">50</option><option value="100">100</option></select></label><span class="pagination-summary" data-page-summary aria-live="polite" aria-atomic="true"></span></div>
    <div class="pagination-actions"><button class="pagination-button" type="button" data-page-action="first" aria-label="First page">First</button><button class="pagination-button" type="button" data-page-action="previous" aria-label="Previous page">Previous</button><span class="pagination-position" data-page-position></span><button class="pagination-button" type="button" data-page-action="next" aria-label="Next page">Next</button><button class="pagination-button" type="button" data-page-action="last" aria-label="Last page">Last</button></div>
  </nav>
</template>
